          "url": "https://humanresearchroadmap.nasa.gov/Risks/?i=179"
        },
        {
          "title": "Lee et al. 2020: more than 60 % of astronauts could not complete a 10-min tilt test on landing day after long-duration flight",
          "url": "https://doi.org/10.3389/fphys.2020.00784"
        }
      ],
      "verified": true
