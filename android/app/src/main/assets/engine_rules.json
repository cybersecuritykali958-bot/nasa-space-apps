        },
        {
          "title": "Gates for sleep, PVT, temperature, blood pressure, heart rate and glucose: team assumption",
          "url": "https://github.com/cybersecuritykali958-bot/nasa-space-apps/blob/main/docs/SCIENCE.md"
        }
      ],
      "verified": false,
      "spaceWeatherGate": true
    },
    {
      "id": "landing",
