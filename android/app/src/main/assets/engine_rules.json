{
  "version": 1,
  "earlyWarning": {
    "minHistory": 7,
    "baselineWindow": 14,
    "ewmaLambda": 0.2,
    "ewmaL": 3.0,
    "cusumK": 0.5,
    "cusumH": 5.0,
    "trendWindowDays": 14,
    "trendHorizonDays": 30,
    "trendMinT": 3.0,
    "sources": [
      {
        "title": "Page 1954, Continuous inspection schemes (CUSUM), Biometrika",
        "url": "https://doi.org/10.1093/biomet/41.1-2.100"
      },
      {
        "title": "Roberts 1959, Control chart tests based on geometric moving averages (EWMA), Technometrics",
        "url": "https://doi.org/10.1080/00401706.1959.10489860"
      },
      {
        "title": "Lucas & Saccucci 1990, Exponentially weighted moving average control schemes, Technometrics",
        "url": "https://doi.org/10.1080/00401706.1990.10484583"
      },
      {
        "title": "CrewPulse check (Monte Carlo, normal data): CUSUM k=0.5, h=5 gives a false signal every ~465 readings and detects a 1 SD shift in ~10; EWMA lambda=0.2, L=3 gives ~555 and ~10",
        "url": "https://github.com/cybersecuritykali958-bot/nasa-space-apps/blob/main/docs/SCIENCE.md"
      }
    ]
  },
  "confidence": {
    "staleAfterHours": 48,
    "estimatedSources": [
      "camera"
    ]
  },
  "triage": {
    "responseWindowMin": {
      "red": 30,
      "yellow": 1440
    },
    "groundHandlingMin": 10,
    "sources": [
      {
        "title": "ACEM Policy P06, Australasian Triage Scale: category 3 (urgent) within 30 minutes; used for a red finding",
        "url": "https://acem.org.au/getmedia/484b39f1-7c99-427b-b46e-005b0cd6ac64/P06_Policy_Australasian_Triage_Scale"
      },
      {
        "title": "Yellow 24 h and ground handling 10 min: team assumptions, see docs/SCIENCE.md (Engine methods)",
        "url": "https://github.com/cybersecuritykali958-bot/nasa-space-apps/blob/main/docs/SCIENCE.md"
      }
    ],
    "verified": false
  },
  "patterns": [
    {
      "id": "fatigue",
      "name": "Fatigue pattern",
      "summary": "Short sleep, slower reactions and low mood together point to accumulated fatigue.",
      "any": [
        {
          "indicator": "sleep_hours",
          "minStatus": "yellow"
        },
        {
          "indicator": "pvt_mean_rt",
          "minStatus": "yellow"
        },
        {
          "indicator": "mood",
          "minStatus": "yellow"
        }
      ],
      "minAny": 2,
      "riskIds": [
        "sleep",
        "behavioral"
      ],
      "advice": "Protect the next sleep window, avoid critical tasks without a cross-check, re-run the PVT tomorrow.",
      "sources": [
        {
          "title": "Basner et al. 2015, Cognition test battery for spaceflight",
          "url": "https://doi.org/10.3357/AMHP.4343.2015"
        },
        {
          "title": "Basner, Mollicone, Dinges 2011, brief PVT (PVT-B) sensitivity to sleep loss",
          "url": "https://doi.org/10.1016/j.actaastro.2011.07.015"
        },
        {
          "title": "Pilcher & Huffcutt 1996, meta-analysis: mood is more affected by sleep deprivation than cognitive or motor performance",
          "url": "https://doi.org/10.1093/sleep/19.4.318"
        },
        {
          "title": "NASA HRP: Risk of sleep loss, circadian desynchronization and work overload",
          "url": "https://humanresearchroadmap.nasa.gov/Risks/?i=100"
        }
      ],
      "verified": false
    },
    {
      "id": "possible_infection",
      "name": "Possible infection",
      "summary": "Raised temperature together with a resting heart rate above your baseline.",
      "all": [
        {
          "indicator": "body_temp",
          "minStatus": "yellow"
        },
        {
          "indicator": "heart_rate",
          "minDeviationPct": 10
        }
      ],
      "riskIds": [
        "immune"
      ],
      "advice": "Rest, fluids, re-measure temperature in 4 hours, tell the crew medical officer.",
      "sources": [
        {
          "title": "Karjalainen & Viitasalo 1986: heart rate rises ~8.5 bpm per 1 °C of fever",
          "url": "https://doi.org/10.1001/archinte.1986.00360180179026"
        },
        {
          "title": "Radin et al. 2020: resting heart rate above the personal baseline flags influenza-like illness",
          "url": "https://doi.org/10.1016/S2589-7500(19)30222-5"
        },
        {
          "title": "NASA HRP: Risk of altered immune response",
          "url": "https://humanresearchroadmap.nasa.gov/Risks/?i=85"
        }
      ],
      "verified": true
    },
    {
      "id": "cardiovascular_strain",
      "name": "Cardiovascular strain",
      "summary": "Blood pressure and resting heart rate are both elevated or drifting upward.",
      "any": [
        {
          "indicator": "systolic_bp",
          "minStatus": "yellow"
        },
        {
          "indicator": "diastolic_bp",
          "minStatus": "yellow"
        },
        {
          "indicator": "systolic_bp",
          "hasAlert": true
        },
        {
          "indicator": "diastolic_bp",
          "hasAlert": true
        }
      ],
      "minAny": 1,
      "riskIds": [
        "cardiovascular"
      ],
      "advice": "Repeat measurements tomorrow morning, review salt and fluid intake, keep planned cardio exercise.",
      "sources": [
        {
          "title": "NASA HRP: Risk of cardiovascular adaptations",
          "url": "https://humanresearchroadmap.nasa.gov/Risks/?i=179"
        },
        {
          "title": "AHA: Understanding blood pressure readings",
          "url": "https://www.heart.org/en/health-topics/high-blood-pressure/understanding-blood-pressure-readings"
        }
      ],
      "verified": true,
      "all": [
        {
          "indicator": "heart_rate",
          "minStatus": "yellow"
        }
      ]
    },
    {
      "id": "self_report_discordance",
      "name": "Self-report does not match the data",
      "summary": "You rate your mood as good, but objective signs of strain disagree. People under pressure tend to underrate symptoms.",
      "all": [
        {
          "indicator": "mood",
          "statusIn": [
            "green"
          ]
        }
      ],
      "any": [
        {
          "indicator": "pvt_mean_rt",
          "minDeviationPct": 15
        },
        {
          "indicator": "sleep_hours",
          "minStatus": "yellow"
        },
        {
          "indicator": "heart_rate",
          "minDeviationPct": 15
        }
      ],
      "minAny": 2,
      "riskIds": [
        "behavioral"
      ],
      "advice": "Take an honest second look at how you feel. Consider a private check-in with the crew medical officer.",
      "sources": [
        {
          "title": "Van Dongen et al. 2003: with chronic sleep restriction, performance kept declining while subjective sleepiness levelled off",
          "url": "https://doi.org/10.1093/sleep/26.2.117"
        },
        {
          "title": "NASA: 5 Hazards of Human Spaceflight (isolation and confinement)",
          "url": "https://www.nasa.gov/hrp/hazards/"
        }
      ],
      "verified": false
    }
  ],
  "readiness": [
    {
      "id": "eva",
      "name": "Spacewalk (EVA)",
      "gates": [
        {
          "indicator": "sleep_hours"
        },
        {
          "indicator": "pvt_mean_rt"
        },
